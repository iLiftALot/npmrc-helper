{
    "name": "npmrc-helper",
    "displayName": "npmrc Helper",
    "version": "0.2.1",
    "description": "Hover docs, auto-completion, and diagnostics for .npmrc (npm & pnpm), pnpm-workspace.yaml (pnpm v11+), and .yarnrc.yml (Yarn Berry)",
    "categories": [
        "Programming Languages",
        "Snippets",
        "Linters"
    ],
    "keywords": [
        "npm",
        "npmrc",
        "pnpm",
        "pnpm-workspace",
        "yarn",
        "yarnrc",
        "config",
        "hints",
        "autocomplete"
    ],
    "homepage": "https://github.com/Yuliang-Lee/npmrc-helper#readme",
    "bugs": {
        "url": "https://github.com/Yuliang-Lee/npmrc-helper/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Yuliang-Lee/npmrc-helper"
    },
    "license": "MIT",
    "publisher": "xlaoyu",
    "main": "./out/extension.js",
    "scripts": {
        "fmt": "zsh scripts/fmt.sh",
        "fmt:check": "zsh scripts/fmt.sh check",
        "fmt:output": "zsh scripts/fmt.sh file-paths",
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "test": "node ./out/test/runTest.js",
        "lint": "eslint src",
        "load": "code --install-extension npmrc-helper-0.2.1-local.vsix --force",
        "package": "vsce package",
        "package:local": "vsce package -o npmrc-helper-0.2.1-local.vsix && npmR load",
        "publish": "vsce publish"
    },
    "contributes": {
        "languages": [
            {
                "id": "npmrc",
                "aliases": [
                    "npmrc",
                    ".npmrc"
                ],
                "filenames": [
                    ".npmrc"
                ],
                "configuration": "./language-configuration.json"
            },
            {
                "id": "yarnrc",
                "aliases": [
                    "yarnrc",
                    ".yarnrc.yml"
                ],
                "filenames": [
                    ".yarnrc.yml",
                    ".yarnrc.yaml"
                ],
                "configuration": "./yarnrc-language-configuration.json"
            },
            {
                "id": "pnpm-workspace",
                "aliases": [
                    "pnpm-workspace",
                    "pnpm-workspace.yaml"
                ],
                "filenames": [
                    "pnpm-workspace.yaml",
                    "pnpm-workspace.yml"
                ],
                "configuration": "./yarnrc-language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "npmrc",
                "scopeName": "source.npmrc",
                "path": "./syntaxes/npmrc.tmLanguage.json"
            },
            {
                "language": "yarnrc",
                "scopeName": "source.yarnrc",
                "path": "./syntaxes/yarnrc.tmLanguage.json"
            },
            {
                "language": "pnpm-workspace",
                "scopeName": "source.pnpm-workspace",
                "path": "./syntaxes/pnpm-workspace.tmLanguage.json"
            }
        ]
    },
    "activationEvents": [],
    "overrides": {
        "glob": "$glob",
        "minimatch@>=7.0.0 <11.0.1": "^11.0.8"
    },
    "dependencies": {
        "@dev-md/ts-log": "latest",
        "@npmcli/config": "^11.2.0"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.6",
        "@types/node": "^20.19.43",
        "@types/vscode": "^1.146.0",
        "@typescript-eslint/eslint-plugin": "^8.57.1",
        "@typescript-eslint/parser": "^8.57.1",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^4.1.1",
        "eslint": "^10.0.3",
        "glob": "^14.0.6",
        "mocha": "^12.0.3",
        "typescript": "^5.3.0"
    },
    "engines": {
        "vscode": "^1.146.0"
    },
    "icon": "images/icon.png",
    "galleryBanner": {
        "color": "#1e1e1e",
        "theme": "dark"
    },
    "allowScripts": {
        "@vscode/vsce-sign@2.1.1": true,
        "fsevents@2.3.3": true,
        "keytar@7.9.0": true
    }
}
